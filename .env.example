# CoffeeGuard AI environment variables (copy to .env; never commit real credentials)

# --- Kaggle (dataset download + remote GPU training)
# Prefer `kaggle auth login` or ~/.kaggle/access_token; this variable also works:
# KAGGLE_API_TOKEN=your_token_from_kaggle_settings

# --- Local tooling
# UV_LINK_MODE=copy            # needed on drives without hard links (exFAT)
# UV_CACHE_DIR=E:/uv-cache     # keep uv's cache off a full system drive
# HF_HOME / TORCH_HOME default to the project's .cache/ folder (set by the CLI)

# --- API (Phase 8)
API_HOST=0.0.0.0
API_PORT=8000
MODEL_BUNDLE=artifacts/models/coffeeguard-effv2b0-v1
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO

# --- Web UI (Phase 9)
API_URL=http://localhost:8000
