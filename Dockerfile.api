# Production-optimized Dockerfile for CoffeeGuard API

FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install --no-cache-dir uv

# Copy dependency files
COPY pyproject.toml .
COPY README.md .

# Copy source code and model
COPY src/ src/
COPY apps/api/ apps/api/
COPY artifacts/ artifacts/

# Install Python dependencies
RUN uv sync --no-dev

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Set environment variables
ENV MODEL_BUNDLE=/app/artifacts/models/coffeeguard-effv2b0-v1
ENV LOG_LEVEL=INFO
ENV MAX_UPLOAD_MB=10
ENV CORS_ORIGINS=*

# Run API
CMD ["uv", "run", "uvicorn", "app.main:app", "--app-dir", "apps/api", "--host", "0.0.0.0", "--port", "8000"]
