# syntax=docker/dockerfile:1
# CoffeeGuard API: FastAPI + ONNX Runtime serving the release bundle (no torch).
#   docker build -f Dockerfile.api -t coffeeguard-api .
#   docker run -p 8000:8000 coffeeguard-api      -> http://localhost:8000/docs

# ---- build: resolve the locked dependencies of the `api` extra into /app/.venv
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra api --no-install-project
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra api --no-editable

# ---- runtime: venv + API code + the release model bundle, as a non-root user
FROM python:3.12-slim
RUN useradd --create-home --uid 10001 app
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY apps/api ./apps/api
COPY artifacts/models/coffeeguard-effv2b0-v1 ./artifacts/models/coffeeguard-effv2b0-v1
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    MODEL_BUNDLE=/app/artifacts/models/coffeeguard-effv2b0-v1 \
    CORS_ORIGINS='["http://localhost:8501"]'
USER app
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)"
CMD ["uvicorn", "app.main:app", "--app-dir", "apps/api", "--host", "0.0.0.0", "--port", "8000"]
